  m_Script: {fileID: 11500000, guid: 7c0d6d2402f9ae740a85ce62a7453bee, type: 3}
  m_Name: dlg_prologue_sorel
  m_EditorClassIdentifier: Assembly-CSharp::ExitClause.Story.DialogueSequence
  id: dlg_prologue_sorel
  lines:
  - speaker: Sorel
    text: Adrian Kade. They sent the retiring man.
    duration: 3.7
    voice: {fileID: 0}
  - speaker: Adrian
    text: Word travels.
    duration: 2.5
    voice: {fileID: 0}
  - speaker: Sorel
    text: You think you're walking away? They'll do the same to you. They always do.
    duration: 5.57
    voice: {fileID: 0}
  - speaker: Adrian
    text: Not my problem after tonight.
    duration: 3.095
    voice: {fileID: 0}
