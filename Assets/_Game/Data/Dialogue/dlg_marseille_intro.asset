  id: dlg_marseille_intro
  lines:
  - speaker: Adrian
    text: Nadia Roux. Mirage. She could be anyone in this crowd. She could have been my neighbour.
    duration: 6.34
    voice: {fileID: 0}
  - speaker: Adrian
    text: Nobody's perfect. Study the faces, find the tells, then confront her.
    duration: 5.295
    voice: {fileID: 0}
