  m_Script: {fileID: 11500000, guid: 7c0d6d2402f9ae740a85ce62a7453bee, type: 3}
  m_Name: dlg_act0_intro
  m_EditorClassIdentifier: Assembly-CSharp::ExitClause.Story.DialogueSequence
  id: dlg_act0_intro
  lines:
  - speaker: Adrian
    text: Villa Serena. Sea view, lemon trees, and a pension with more zeros than I ever earned honestly.
    duration: 6.725
    voice: {fileID: 0}
  - speaker: Adrian
    text: Sofia runs the bookshop by the harbour. She thinks I sold insurance.
    duration: 5.24
    voice: {fileID: 0}
  - speaker: Adrian
    text: Normal life. Groceries. Coffee. Sleep. How hard can it be?
    duration: 4.69
    voice: {fileID: 0}
