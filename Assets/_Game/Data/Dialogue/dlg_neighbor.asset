  m_Name: dlg_neighbor
  m_EditorClassIdentifier: Assembly-CSharp::ExitClause.Story.DialogueSequence
  id: dlg_neighbor
  lines:
  - speaker: Claire
    text: Bonjour! I'm Claire, I just moved in next door. You live alone? What is it you do?
    duration: 6.0099998
    voice: {fileID: 0}
  - speaker: Claire
    text: Do you travel much? When are you usually home? I'm always locking myself out!
    duration: 5.735
    voice: {fileID: 0}
  - speaker: Adrian
    text: Insurance. Rarely. Nice to meet you, Claire.
    duration: 3.92
    voice: {fileID: 0}
