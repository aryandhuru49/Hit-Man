  id: dlg_luca
  lines:
  - speaker: Luca
    text: You don't remember me. Vienna, 2015. Dieter Brandt was my father.
    duration: 5.075
    voice: {fileID: 0}
  - speaker: Adrian
    text: ...
    duration: 2.5
    voice: {fileID: 0}
  - speaker: Luca
    text: I didn't come to kill you. I just wanted to see what kind of man does that and then buys lemons at the market.
    duration: 7.55
