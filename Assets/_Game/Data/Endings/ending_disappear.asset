  m_Script: {fileID: 11500000, guid: 5b7cf6fd1b2c90b49ad4677f3a8bfd35, type: 3}
  m_Name: ending_disappear
  m_EditorClassIdentifier: Assembly-CSharp::ExitClause.Story.EndingDefinition
  id: ending_disappear
  title: Gone
  epilogue: 'Villa Serena burns on a Tuesday. The agency''s investigators find the body of a man about Adrian Kade''s height and close the file.


    In a fishing town nobody visits, a quiet man rents a room above a bar. He pays cash and never talks about his old job.


    The agency never lets anyone retire. So he didn''t. He just stopped existing.'
  lovedOneSavedLine: Every spring, a bookshop on the Riviera receives a postcard with no signature and a pressed lemon blossom.
  lovedOneLostLine: He keeps one photograph. He never looks at it, and he never throws it away.
  informantLine: 'A postcard arrives from Marseille too, addressed to no one: ''We''re even.'''
  minEvidence: 0
  minRageUses: 0
  requiresNoSpare: 0
